<idea-plugin>
    <id>com.sage.plugin</id>
    <name>Sage for Copilot Chat</name>
    <vendor email="sudipta.earth@gmail.com" url="https://github.com/sudiptaearth/sage">Sage</vendor>
    <description>Analyse GitHub Copilot chat sessions for mistakes and update instructions files; also export sessions to Markdown format</description>
    <version>0.1.1</version>
    <idea-version since-build="242.0"/>
    
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.sage.plugin.ExportSettingsState"/>
        <applicationConfigurable
                instance="com.sage.plugin.ExportSettingsConfigurable"
                displayName="Sage"
                id="com.sage.settings"/>
        <notificationGroup id="Sage" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action
                id="com.sage.CopilotChatAction"
                class="com.sage.plugin.CopilotChatAction"
                text="Summon Sage"
                description="Analyse Copilot chat sessions for mistakes and update instructions files, or export a session to Markdown">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
